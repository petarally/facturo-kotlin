uro-kotlin\.gitignore
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Kotlin Gradle plugin data, see https://kotlinlang.org/docs/whatsnew20.html#new-directory-for-kotlin-data-in-gradle-projects
.kotlin/

# Gradle files
.gradle/
build/
gradle-app.setting
!gradle-wrapper.jar

# IntelliJ IDEA files
.idea/
*.iml
*.iws
*.ipr
*.iws
out/

# Visual Studio Code
.vscode/
*.code-workspace

# Local configuration file
local.properties

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# SQLite database files
*.db
*.sqlite
*.sqlite3

# Application specific files
database/
logs/